{
  "name": "codemirror-lang-dart",
  "version": "1.0.0",
  "description": "Dart language support for CodeMirror 6",
  "main": "dist/index.cjs",
  "type": "module",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "module": "dist/index.js",
  "sideEffects": false,
  "types": "dist/src/index.d.ts",
  "author": "Dart project authors",
  "license": "BSD-3-Clause",
  "keywords": [
    "codemirror",
    "codemirror6",
    "dart",
    "lezer",
    "grammar",
    "syntax-highlighting"
  ],
  "files": [
    "dist"
  ],
  "workspaces": [
    "example"
  ],
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.0.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.4",
    "@lezer/generator": "^1.8.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^8.56.0",
    "rollup": "^2.52.2",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.53.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dart-lang/dart-syntax-highlight"
  },
  "scripts": {
    "build": "rollup -c",
    "build-debug": "rollup -c",
    "prepare": "npm run build",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "npm run build && node --import tsx --test test/**/*_test.ts test/*_test.ts"
  }
}
