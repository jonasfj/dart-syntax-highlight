@top Program { (Directive | Declaration)* }

@precedence {
  label,
  nullable,
  member,
  call,
  index,
  postfix,
  prefix,
  type,
  generic,
  func,
  param,
  catch,
  varDeclIdentifier,
  constructor,
  pattern,
  mul @left,
  add @left,
  shift @left,
  bitAnd @left,
  bitXor @left,
  bitOr @left,
  rel @left,
  typeOp @left,
  eq @left,
  logAnd @left,
  logOr @left,
  nullCoal @left,
  cascade @left,
  cond @right,
  assign @right,
  else @right
}

@external propSource dartHighlight from "./highlight"

@skip { space | LineComment | BlockComment | DocComment | DocBlockComment }

Directive {
  Metadata* (
    ImportDirective |
    ExportDirective |
    LibraryDirective |
    PartDirective |
    PartOfDirective
  )
}

LibraryDirective {
  kw<"library"> (Identifier ("." Identifier)*)? ";"
}

PartDirective {
  kw<"part"> String ";"
}

PartOfDirective {
  kw<"part"> kw<"of"> (Identifier ("." Identifier)* | String) ";"
}

ImportDirective {
  kw<"import"> String (kw<"as"> Identifier)? (kw<"show"> IdentifierList)? (kw<"hide"> IdentifierList)? ";"
}

ExportDirective {
  kw<"export"> String (kw<"show"> IdentifierList)? (kw<"hide"> IdentifierList)? ";"
}

IdentifierList {
  Identifier ("," Identifier)*
}

Metadata {
  "@" Identifier ("." Identifier)? ~meta ("(" ArgumentList ")")?
}

Declaration {
  Metadata+ (
    FunctionDeclaration |
    VariableDeclaration |
    ClassDeclaration |
    MixinDeclaration |
    ExtensionTypeDeclaration |
    ExtensionDeclaration |
    EnumDeclaration |
    Typedef
  ) |
  (
    FunctionDeclaration |
    VariableDeclaration |
    ClassDeclaration |
    MixinDeclaration |
    ExtensionTypeDeclaration |
    ExtensionDeclaration |
    EnumDeclaration |
    Typedef
  )
}

ExtensionDeclaration {
  kw<"extension"> (Identifier)? (!generic TypeArguments)? kw<"on"> Type ClassBody
}

Typedef {
  kw<"typedef"> Identifier (!generic TypeArguments)? "=" Type ";" |
  kw<"typedef"> Type? Identifier ~ambig ParameterList ";"
}

ExtensionTypeDeclaration {
  kw<"extension"> kw<"type"> kw<"const">? Type ("." Identifier)? "(" ParameterList ")" (kw<"implements"> TypeList)? ClassBody
}

EnumDeclaration {
  kw<"enum"> Identifier (!generic TypeArguments)? (kw<"with"> TypeList)? (kw<"implements"> TypeList)? "{" EnumBody? "}"
}

EnumBody {
  EnumEntry ("," EnumEntry)* ","? ";" MemberDeclaration* |
  EnumEntry ("," EnumEntry)* ","? |
  ";" MemberDeclaration*
}

EnumEntry {
  Metadata* Identifier TypeArguments? ("." Identifier)? ArgumentList?
}

ClassDeclaration {
  classModifier+ ~mod kw<"class"> Identifier (TypeParameters)? (kw<"extends"> Type)? (kw<"with"> TypeList)? (kw<"implements"> TypeList)? ClassBody |
  kw<"class"> Identifier (TypeParameters)? (kw<"extends"> Type)? (kw<"with"> TypeList)? (kw<"implements"> TypeList)? ClassBody
}

classModifier {
  kw<"abstract"> | kw<"base"> | kw<"interface"> | kw<"final"> | kw<"sealed"> | kw<"mixin">
}

MixinDeclaration {
  mixinModifier+ ~mod kw<"mixin"> Identifier (TypeParameters)? (kw<"on"> TypeList)? (kw<"implements"> TypeList)? ClassBody |
  kw<"mixin"> Identifier (TypeParameters)? (kw<"on"> TypeList)? (kw<"implements"> TypeList)? ClassBody
}

mixinModifier {
  kw<"base">
}

TypeList {
  Type ("," Type)*
}

ClassBody {
  "{" MemberDeclaration* "}"
}

MemberDeclaration {
  Metadata* (
    !constructor ConstructorDeclaration | 
    FunctionDeclaration | 
    Getter | 
    Setter | 
    VariableDeclaration
  ) |
  ";"
}


Getter {
  Type? kw<"get"> Identifier (Block | "=>" expression ";")
}

Setter {
  Type? kw<"set"> Identifier "(" Parameter ")" (Block | "=>" expression ";")
}

// ...

FunctionDeclaration {
  !func (Async | AsyncStar | SyncStar)? (
    Type Identifier |
    Identifier
  ) ~ambig (TypeParameters)? "(" ParameterList ")" (Block | "=>" expression ";") ~ambig
}

Type {
  TypeNoQuestion ~ambig "?"?
}

TypeNoQuestion {
  (TypeIdentifier (!generic TypeArguments)? |
  RecordType |
  FunctionType |
  kw<"void">) ~ambig
}

FunctionType {
  Type? kw<"Function"> (!generic TypeArguments)? "(" ParameterTypeList ")"
}

ParameterTypeList {
  (ParameterType ("," ParameterType)* ","?)?
}

ParameterType {
  Metadata* Type Identifier?
}

ConstructorDeclaration[@dynamicPrecedence=10] {
  !constructor (kw<"const"> !constructor | kw<"factory">) ~mod Identifier ("." Identifier)? ~constructor !constructor "(" ParameterList ")"
  (
    ":" Initializers (Block | ";") |
    "=" Type ("." Identifier)? ";" |
    Block |
    "=>" expression ";" |
    ";"
  ) |
  !constructor Identifier ("." Identifier)? "(" ParameterList ")"
  (
    ":" Initializers (Block | ";") |
    "=" Type ("." Identifier)? ";" |
    Block |
    "=>" expression ";" |
    ";"
  )
}

Initializers {
  Initializer ("," Initializer)*
}

Initializer {
  kw<"super"> ("." Identifier)? ArgumentList |
  kw<"this"> ("." Identifier)? ArgumentList |
  Identifier ("." Identifier)? "=" expression
}



ParameterList {
  (
    (Parameter ("," Parameter)*)? ("," OptionalParameterList)? |
    OptionalParameterList
  ) ","?
}

OptionalParameterList {
  "[" Parameter ("," Parameter)* ","? "]" |
  "{" NamedParameter ("," NamedParameter)* ","? "}"
}

Parameter {
  Metadata* (Type !param Identifier | Identifier | kw<"this"> "." Identifier | kw<"super"> "." Identifier)
}

NamedParameter {
  Metadata* kw<"required">? (Type !param Identifier | Identifier | kw<"this"> "." Identifier | kw<"super"> "." Identifier) ("=" expression)?
}

Block {
  "{" (Statement | Declaration)* "}" ~ambig
}

Statement {
  Label* (
    ExpressionStatement |
    Block |
    IfStatement |
    WhileStatement |
    DoWhileStatement |
    SwitchStatement |
    ForStatement |
    BreakStatement |
    ContinueStatement |
    ReturnStatement |
    TryStatement |
    AssertStatement |
    RethrowStatement |
    YieldStatement
  )
}

AssertStatement {
  kw<"assert"> "(" expression ("," expression)? ","? ")" ";"
}

RethrowStatement {
  kw<"rethrow"> ";"
}

DoWhileStatement {
  kw<"do"> Statement kw<"while"> "(" expression ")" ";"
}

BreakStatement {
  kw<"break"> Identifier? ";"
}

ContinueStatement {
  kw<"continue"> Identifier? ";"
}

SwitchStatement {
  kw<"switch"> "(" expression ")" "{" (SwitchLabel | Statement)* "}"
}

SwitchLabel[@dynamicPrecedence=1] {
  Label* (
    kw<"case"> Pattern WhenClause? ":" |
    kw<"default"> ":"
  )
}

WhenClause {
  kw<"when"> expression
}

Label {
  Identifier !label ":"
}

YieldStatement {
  (Yield | YieldStar) expression ";"
}

TryStatement {
  kw<"try"> Block (OnClause | CatchClause)+ FinallyClause? |
  kw<"try"> Block FinallyClause
}

OnClause {
  kw<"on"> Type (kw<"catch"> CatchClauseBody | Block)
}

CatchClause {
  kw<"catch"> CatchClauseBody
}

CatchClauseBody {
  "(" Identifier ("," Identifier)? ")" Block
}

FinallyClause {
  kw<"finally"> Block
}

ExpressionStatement { expression ";" }

IfStatement {
  kw<"if"> "(" expression (kw<"case"> Pattern WhenClause?)? ")" Statement (!else kw<"else"> Statement)?
}

WhileStatement {
  kw<"while"> "(" expression ")" Statement
}

ForStatement {
  kw<"for"> ("(" ( ( (kw<"var"> | kw<"final"> | kw<"const"> | Type)? Pattern ("=" expression)? ) | expression | "") ";" expression? ";" expression? ")")? Statement
}

ReturnStatement {
  kw<"return"> expression? ";"
}

VariableDeclaration {
  (
    (kw<"var"> | kw<"final"> | kw<"const">)? Type !varDeclIdentifier Identifier ("=" expression)? ("," Identifier ("=" expression)?)* |
    patternVarDecl
  ) ~ambig ";"
}

patternVarDecl[@dynamicPrecedence=-10] {
  (kw<"var"> | kw<"final"> | kw<"const">) !pattern Pattern ("=" expression)?
}

Literal {
  NumberLiteral |
  BooleanLiteral |
  NullLiteral |
  String |
  ListLiteral |
  SetOrMapLiteral |
  RecordLiteral
}

ListLiteral {
  kw<"const">? (!generic TypeArguments)? "[" (Element ("," Element)* ","?)? "]"
}

SetOrMapLiteral {
  kw<"const">? (!generic TypeArguments)? "{" (Element ("," Element)* ","?)? "}" ~ambig
}

Element {
  (expression ~ambig) |
  MapEntry |
  (SpreadElement ~ambig) |
  IfElement |
  ForElement
}

MapEntry {
  expression ":" expression
}

SpreadElement {
  ("..." | "...?") expression
}

IfElement {
  kw<"if"> "(" expression ")" Element (!else kw<"else"> Element)?
}

ForElement {
  kw<"for"> "(" ( ( (kw<"var"> | kw<"final"> | kw<"const"> | Type)? Pattern ("=" expression)? ) | expression | "") ";" expression? ";" expression? ")" Element |
  kw<"await">? kw<"for"> "(" ( (kw<"var"> | kw<"final"> | Type)? Pattern ) kw<"in"> expression ")" Element
}
expression {
  Identifier |
  Literal |
  AssignmentExpression |
  BinaryExpression |
  UnaryExpression |
  TypeExpression |
  CascadeExpression |
  ConditionalExpression |
  MemberExpression |
  CallExpression |
  IndexExpression |
  ThrowExpression |
  ParenthesizedExpression
}

ThrowExpression {
  kw<"throw"> expression
}

ParenthesizedExpression { "(" expression ")" }

AssignmentExpression {
  Pattern !assign ( "=" | CompoundAssign ) expression
}

UnaryExpression {
  !prefix ( "!" | "~" | "-" | "++" | "--" ) expression |
  expression !postfix ( "++" | "--" | "!" )
}

BinaryExpression {
  expression !mul ("*" | "/" | "%" | "~/") expression |
  expression !add ("+" | "-") expression |
  expression !shift ShiftOp expression |
  expression !bitAnd "&" expression |
  expression !bitXor "^" expression |
  expression !bitOr "|" expression |
  expression !rel ("<" | ">" | "<=" | ">=") expression |
  expression !eq ("==" | "!=") expression |
  expression !logAnd "&&" expression |
  expression !logOr "||" expression |
  expression !nullCoal "??" expression
}

TypeExpression {
  expression !typeOp ( kw<"is"> "!"? | kw<"as"> ) Type
}

ConditionalExpression {
  expression !cond "?" expression ":" expression
}

CascadeExpression {
  expression !cascade (CascadeOp CascadeSection)+
}

CascadeOp { ".." | "?.." }

CascadeSection {
  !cascade Identifier ArgumentList? |
  "[" expression "]"
}

MemberExpression {
  expression !member ("." | "?.") Identifier
}

CallExpression {
  expression !call ~ambig ArgumentList
}

IndexExpression {
  expression !index ("[" | QuestionBracket) expression "]"
}

ArgumentList {
  "(" (Argument ("," Argument)* ","?)? ")"
}

Argument {
  (Identifier ":")? expression
}



TypeIdentifier[@dynamicPrecedence=-1] {
  !type Identifier
}

TypeArguments {
  "<" Type ("," Type)* ">"
}

TypeParameters {
  "<" TypeParameter ("," TypeParameter)* ">"
}

TypeParameter {
  Metadata* Identifier (kw<"extends"> Type)?
}

RecordType {
  "(" (
    RecordTypeField ("," RecordTypeField)* "," RecordTypeNamedBlock |
    RecordTypeField ("," RecordTypeField)* ","? |
    RecordTypeNamedBlock
  )? ")" ~ambig
}

RecordTypeField {
  Metadata* Type Identifier?
}

RecordTypeNamedBlock {
  "{" RecordTypeNamedField ("," RecordTypeNamedField)* ","? "}"
}

RecordTypeNamedField {
  Metadata* Type Identifier
}



RecordLiteral {
  kw<"const">? "(" (
    expression "," (RecordField ("," RecordField)* ","?)? |
    NamedRecordField ("," RecordField)* ","? |
    ""
  ) ")"
}

RecordField {
  NamedRecordField | expression ~ambig
}

NamedRecordField {
  Identifier ":" expression
}

String {
  (SingleString | DoubleString | TripleSingleString | TripleDoubleString | RawString)+
}

RawString {
  RawSingleString | RawDoubleString | RawTripleSingleString | RawTripleDoubleString
}

@local tokens {
  SingleQuoteEnd { "'" }
  SingleEscape { "\\" _ }
  SingleInterpolationStart { "$" }
  @else singleContent
}

@local tokens {
  DoubleQuoteEnd { '"' }
  DoubleEscape { "\\" _ }
  DoubleInterpolationStart { "$" }
  @else doubleContent
}

@local tokens {
  TripleSingleQuoteEnd { "'''" }
  TripleSingleEscape { "\\" _ }
  TripleSingleInterpolationStart { "$" }
  @else tripleSingleContent
}

@local tokens {
  TripleDoubleQuoteEnd { '"""' }
  TripleDoubleEscape { "\\" _ }
  TripleDoubleInterpolationStart { "$" }
  @else tripleDoubleContent
}

@local tokens {
  RawSingleQuoteEnd { "'" }
  @else rawSingleContent
}

@local tokens {
  RawDoubleQuoteEnd { '"' }
  @else rawDoubleContent
}

@local tokens {
  RawTripleSingleQuoteEnd { "'''" }
  @else rawTripleSingleContent
}

@local tokens {
  RawTripleDoubleQuoteEnd { '"""' }
  @else rawTripleDoubleContent
}

@skip {} {
  SingleString {
    SingleQuote (singleContent | SingleEscape | InterpolationSingle)* SingleQuoteEnd
  }
  DoubleString {
    DoubleQuote (doubleContent | DoubleEscape | InterpolationDouble)* DoubleQuoteEnd
  }
  TripleSingleString {
    TripleSingleQuote (tripleSingleContent | TripleSingleEscape | InterpolationTripleSingle)* TripleSingleQuoteEnd
  }
  TripleDoubleString {
    TripleDoubleQuote (tripleDoubleContent | TripleDoubleEscape | InterpolationTripleDouble)* TripleDoubleQuoteEnd
  }
  RawSingleString {
    RawSingleQuote rawSingleContent* RawSingleQuoteEnd
  }
  RawDoubleString {
    RawDoubleQuote rawDoubleContent* RawDoubleQuoteEnd
  }
  RawTripleSingleString {
    RawTripleSingleQuote rawTripleSingleContent* RawTripleSingleQuoteEnd
  }
  RawTripleDoubleString {
    RawTripleDoubleQuote rawTripleDoubleContent* RawTripleDoubleQuoteEnd
  }
}

InterpolationSingle {
  SingleInterpolationStart (Identifier | "{" expression "}")
}

InterpolationDouble {
  DoubleInterpolationStart (Identifier | "{" expression "}")
}

InterpolationTripleSingle {
  TripleSingleInterpolationStart (Identifier | "{" expression "}")
}

InterpolationTripleDouble {
  TripleDoubleInterpolationStart (Identifier | "{" expression "}")
}

BooleanLiteral { kw<"true"> | kw<"false"> }
NullLiteral { kw<"null"> }

kw<term> { @specialize[@name={term}]<Identifier, term> }

Async { @specialize<Identifier, "async"> }
AsyncStar { @specialize<Identifier, "async*"> }
SyncStar { @specialize<Identifier, "sync*"> }
Yield { @specialize<Identifier, "yield"> }
YieldStar { @specialize<Identifier, "yield*"> }

@tokens {
  Identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }

  NumberLiteral {
    (@digit+ ("." @digit+)? | "." @digit+) ( $[eE] $[+-]? @digit+ )? |
    "0x" $[0-9a-fA-F]+
  }

  SingleQuote { "'" }
  DoubleQuote { '"' }
  TripleSingleQuote { "'''" }
  TripleDoubleQuote { '"""' }
  RawSingleQuote { "r'" }
  RawDoubleQuote { 'r"' }
  RawTripleSingleQuote { "r'''" }
  RawTripleDoubleQuote { 'r"""' }

  ShiftOp { "<<" | ">>" | ">>>" }
  CompoundAssign { "+=" | "-=" | "*=" | "/=" | "%=" | "~/=" | "&=" | "|=" | "^=" | "<<=" | ">>=" | ">>>=" | "??=" }

  @precedence {
    RawTripleSingleQuote, RawTripleDoubleQuote, TripleSingleQuote, TripleDoubleQuote,
    RawSingleQuote, RawDoubleQuote, SingleQuote, DoubleQuote,
    DocComment, LineComment, DocBlockComment, BlockComment,
    CompoundAssign, ShiftOp, NumberLiteral, ".", "/", "*", "+", "-", "%", "^", "&", "|", "~/", "~", Identifier
  }

  "+" "-" "*" "/" "%" "~/"
  "&" "|" "^" "~"
  "<<" ">>" ">>>"
  "<" ">" "<=" ">=" "==" "!=" "&&" "||"
  "?" "!" "++" "--" "??" "?."
  QuestionBracket { "?" "[" }
  "=>"

  ";" ":" "(" ")" "{" "}" "[" "]" "," "." "=" "@"

  space { $[ \t\n\r]+ }

  LineComment { "//" ![\n]* }
  DocComment { "///" ![\n]* ($[ \t\n]* "///" ![\n]*)* }

  BlockComment { "/*" blockCommentRest }
  DocBlockComment { "/**" blockCommentRest }
  blockCommentRest { ![*] blockCommentRest | "*" blockCommentAfterStar }
  blockCommentAfterStar { "/" | "*" blockCommentAfterStar | ![/*] blockCommentRest }
}

Pattern {
  Pattern !logOr "||" Pattern |
  Pattern !logAnd "&&" Pattern |
  RelationalPattern |
  UnaryPattern |
  PrimaryPattern
}

RelationalPattern {
  ("==" | "!=" | "<" | ">" | "<=" | ">=") expression
}

UnaryPattern {
  Pattern !typeOp kw<"as"> Type |
  PrimaryPattern ("?" | "!") ~ambig
}

PrimaryPattern {
  Literal ~ambig |
  Identifier ~ambig |
  ParenthesizedPattern |
  ListPattern |
  MapPattern
}

ParenthesizedPattern { "(" Pattern ~ambig ")" ~ambig }

ListPattern {
  (!generic TypeArguments)? "[" (PatternElement ("," PatternElement)* ","?)? "]" ~ambig
}

PatternElement { (Pattern ~ambig) | (SpreadElement ~ambig) }

MapPattern {
  (!generic TypeArguments)? "{" (MapPatternEntry ("," MapPatternEntry)* ","?)? "}" ~ambig
}

MapPatternEntry {
  expression ":" Pattern |
  "..."
}

RecordPattern {
  "(" (PatternField ("," PatternField)* ","?)? ")" ~ambig
}

PatternField {
  (Identifier ~ambig ":")? Pattern ~ambig
}

ObjectPattern[@dynamicPrecedence=-2] {
  TypeNoQuestion (!generic TypeArguments)? ~ambig ~constructor "(" (PatternField ("," PatternField)* ","?)? ")"
}
